{
  "name": "pokemon_api",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/poppins": "^5.0.14",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@mui/icons-material": "^5.15.17",
    "@mui/material": "^5.15.17",
    "@react-oauth/google": "^0.13.5",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "autoprefixer": "^10.4.19",
    "axios": "^1.7.1",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-material-ui-carousel": "^3.4.2",
    "react-router-dom": "^6.23.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix pokemon-backend",
    "eslint-check": "eslint src --ext .ts,.tsx",
    "eslint-format": "eslint src --ext .ts,.tsx --fix",
    "prettier-check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\" \"pokemon-backend/**/*.ts\"",
    "prettier-format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\" \"pokemon-backend/**/*.ts\"",
    "check": "npm run typecheck && npm run eslint-check && npm run prettier-check",
    "fix": "npm run prettier-format && npm run eslint-format && npm run typecheck"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^8.57.0",
    "prettier": "^3.9.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^4.9.5"
  }
}
